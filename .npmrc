# @cdp-wasm-suite packages (cdp-sampler) live on GitHub Packages, which
# requires auth even for public installs. Put a PAT with read:packages in your
# user npmrc:  //npm.pkg.github.com/:_authToken=<token>  (~/.npmrc), or grant
# the gh CLI the scope once: gh auth refresh -s read:packages
@cdp-wasm-suite:registry=https://npm.pkg.github.com
